# ── Application Config ──────────────────────────────────────────────

# Secret key for signing JWT tokens.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in production
SECRET_KEY=change-me-in-production

# Runtime environment. Set to "production" in production.
# Optional — defaults to "development"
ENVIRONMENT=development

# Debug mode. Do NOT enable in production.
# Optional — defaults to False
# DEBUG=False

# Comma-separated list of allowed CORS origins.
# Only used when ENVIRONMENT=production.
# Optional — defaults to "http://localhost:3000,http://localhost:7860"
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860

# Comma-separated Host header allowlist for TrustedHostMiddleware.
# Example production: api.example.com,www.example.com
# Optional — defaults to localhost / FRONTEND_URL hostname
# ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com


# ── Database (Amazon RDS MySQL for docker compose / ECS) ─────

# Required by docker-compose.yml. Point at RDS (or any MySQL 8.x).
# Example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@YOUR_RDS_ENDPOINT:3306/pdf_rag?charset=utf8mb4
# (`mysql://` is upgraded to `mysql+pymysql://` automatically.)
# Local non-Docker default remains sqlite:///./data/app.db when unset.
# DATABASE_URL=mysql+pymysql://pdf_rag_user:CHANGE_ME@localhost:3306/pdf_rag?charset=utf8mb4

# Connection pool tuning (used for MySQL; SQLite ignores these).
# Optional — defaults shown
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_PRE_PING=True
# DATABASE_POOL_RECYCLE=3600


# ── Field-level Encryption ─────────────────────────────────

# Dedicated key for encrypting sensitive user fields (tokens, secrets).
# Must be set in production — no default value is provided.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required in production
# FIELD_ENCRYPTION_KEY=your_32_byte_base64_encoded_key

# Previous field key during rotation (reads try primary then previous).
# Remove after re-encryption completes. See security-audit/SECRET_ROTATION_RUNBOOK.md
# FIELD_ENCRYPTION_KEY_PREVIOUS=

# Redis password (compose injects into CELERY_* / REDIS_URL). Required for compose.
# REDIS_PASSWORD=changeme-genova-redis

# Cookie session (HttpOnly). Static-export compatible — no Next BFF required.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# AUTH_RETURN_BODY_TOKENS=true
# AUTH_COOKIE_CSRF=true


# ── Authentication ──────────────────────────────────────────

# JWT signing algorithm. Leave as default (HS256) unless you know what you're doing.
# Optional — defaults to "HS256"
# JWT_ALGORITHM=HS256

# JWT access token expiry in minutes.
# Optional — defaults to 15
# JWT_ACCESS_EXPIRY_MINUTES=15

# JWT refresh token expiry in days.
# Optional — defaults to 7
# JWT_REFRESH_EXPIRY_DAYS=7

# Google OAuth client ID for backend ID-token verification.
# Optional — required only for Google sign-in.
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Google OAuth client secret for Drive read-only access.
# Optional — required only for Google Drive sync.
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Callback URL registered in your Google OAuth web client.
# Local: http://127.0.0.1:7860/api/v1/auth/google-drive/callback
# POC:   https://rag.genova-ai.yokaiq.in/api/v1/auth/google-drive/callback
# Also add Authorized JavaScript origin: https://rag.genova-ai.yokaiq.in
# GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:7860/api/v1/auth/google-drive/callback

# When false (POC default), register creates a verified user — no email link.
# REQUIRE_EMAIL_VERIFICATION=false

# Background Drive PDF sync (APScheduler). Manual Sync Now works without this.
# DRIVE_SYNC_ENABLED=false
# DRIVE_SYNC_INTERVAL_MINUTES=60

# Public frontend URL used to build email verification links.
# Optional — defaults to http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email verification token lifetime in hours.
# Optional — defaults to 24
# EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24


# ── SMTP / Email ───────────────────────────────────────────

# SMTP settings used to send account verification emails.
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_or_gmail_app_password
MAIL_FROM=your_sender_email@example.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False


# ── Celery / Redis Background Processing ───────────────────

# Redis URL used by FastAPI to enqueue PDF processing jobs.
# Optional — defaults to redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0

# Redis URL used by Celery to store task results/status.
# Optional — defaults to redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/1


# ── AWS S3 (per-user PDFs + sticky notes) ────────────────

# Bucket used for document PDFs and CKEditor sticky notes.
# Layout: s3://<bucket>/NoteBase/{user_id}/pdfs/<file>
#     and s3://<bucket>/NoteBase/{user_id}/sticky_notes/notes.json
# Leave empty to store documents on local disk only (notes then stay on-device).
# Prefer AWS_S3_BUCKET; S3_BUCKET remains supported as an alias.
# AWS_S3_BUCKET=gen-research
# S3_BUCKET=gen-research

# Optional root folder before {user_id}/. Leave empty for:
#   s3://<bucket>/{user_id}/pdfs/… and …/sticky_notes/notes.json
# S3_BASE_PREFIX=

# Region for the S3 client. Falls back to AWS_REGION / AWS_DEFAULT_REGION.
# AWS_REGION=us-east-1
# S3_REGION=us-east-1

# Optional custom endpoint for MinIO / LocalStack.
# S3_ENDPOINT_URL=http://localhost:9000

# Server-side encryption for stored objects (set empty to disable).
# S3_SERVER_SIDE_ENCRYPTION=AES256

# Credentials are read from the standard AWS provider chain — never commit them.
# Prefer an IAM role/instance profile; for local development use env vars:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=


# ── File Upload ─────────────────────────────────────────────

# Directory where uploaded documents are stored.
# Optional — defaults to "./data/uploads"
# UPLOAD_DIR=./data/uploads

# Maximum upload file size in megabytes.
# Optional — defaults to 50
# MAX_UPLOAD_SIZE_MB=50

# Comma-separated list of allowed file extensions.
# Optional — defaults to "pdf,docx,txt,md"
# ALLOWED_EXTENSIONS=pdf,docx,txt,md


# ── LLM / Embedding providers ───────────────────────────────
# Localhost (ENVIRONMENT=development): Ollama qwen2.5 + nomic-embed-text
# Production (ENVIRONMENT=production): Bedrock Nova 2 Lite + Titan V2
# Production UI never offers Ollama (https://rag.genova-ai.yokaiq.in/).
#
# Local defaults:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# CHROMA_PERSIST_DIR=./data/chroma_db_ollama_nomic
#
# Production / docker-compose defaults:
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# BEDROCK_REGION=us-east-1
# Optional Bedrock API key; when unset, uses IAM / default AWS credentials:
# AWS_BEARER_TOKEN_BEDROCK=
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDING_DIMENSION=1024
# CHROMA_PERSIST_DIR=/app/data/chroma_db_bedrock_titan_v2

# ── LLM Configuration ───────────────────────────────────────

# Model id for the active LLM_PROVIDER (Ollama tag, or unused when Bedrock sets BEDROCK_MODEL_ID).
# LLM_MODEL=qwen2.5:3b

# Sampling temperature (0.0 = deterministic, 1.0 = very creative).
# Optional — defaults to 0.3
# LLM_TEMPERATURE=0.3

# Maximum number of tokens the LLM can generate per response.
# Optional — defaults to 1024
# LLM_MAX_NEW_TOKENS=1024


# ── LangSmith Tracing (Optional) ────────────────────────

# Enable LangSmith tracing for the backend RAG pipeline.
# Optional — defaults to False
# LANGSMITH_TRACING=False

# LangSmith API key.
# Optional — only needed when LANGSMITH_TRACING=True
# LANGSMITH_API_KEY=

# LangSmith API endpoint.
# Optional — defaults to "https://api.smith.langchain.com"
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith project name used for traced runs.
# Optional — defaults to "pdf-assistant-rag"
# LANGSMITH_PROJECT=pdf-assistant-rag


# ── Embeddings ──────────────────────────────────────────────

# SentenceTransformer model ID for generating document embeddings.
# Model is downloaded once and cached locally. No external API call.
# Optional — defaults to "sentence-transformers/all-MiniLM-L6-v2"
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Dimension of the embedding vectors (must match the model output).
# Optional — defaults to 384
# EMBEDDING_DIMENSION=384


# ── RAG Config ──────────────────────────────────────────────

# Number of characters per document chunk.
# Optional — defaults to 1000
# CHUNK_SIZE=1000

# Character overlap between consecutive chunks.
# Optional — defaults to 200
# CHUNK_OVERLAP=200

# Number of candidate chunks retrieved during semantic search.
# Optional — defaults to 20
# TOP_K_RETRIEVAL=20

# Number of top chunks passed to the LLM after reranking.
# Optional — defaults to 8
# TOP_K_RERANK=8

# Cross-encoder model used for reranking.
# Optional — defaults to "BAAI/bge-reranker-v2-m3"
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3


# ── Knowledge Graph / GraphRAG ──────────────────────────────

# Directory where GraphRAG stores per-document knowledge graphs.
# Optional — defaults to "./data/graphs"
# GRAPH_PERSIST_DIR=./data/graphs

# Maximum number of graph relationships appended to the RAG prompt.
# Optional — defaults to 12
# GRAPH_MAX_RELATIONSHIPS=12


# ── ChromaDB (Vector Store) ─────────────────────────────────

# Directory where ChromaDB persists its vector index to disk.
# Optional — defaults to "./data/chroma_db"
# CHROMA_PERSIST_DIR=./data/chroma_db


# ── Document Cleanup ────────────────────────────────────────

# Enable automatic cleanup of inactive active documents.
# Optional — defaults to True
# DOC_CLEANUP_ENABLED=True

# Number of days without access before an active document is purged.
# Optional — defaults to 30
# DOC_CLEANUP_INACTIVE_DAYS=30

# Number of days a soft-deleted document is kept before permanent deletion.
# Optional — defaults to 90
# DOC_CLEANUP_MAX_AGE_DAYS=90


# ── Workspace Invitations ──────────────────────────────────

# Public-facing app URL used in invitation emails.
# Optional — defaults to "http://localhost:3000"
# APP_URL=http://localhost:3000

# Invitation token expiry in hours.
# Optional — defaults to 72
# INVITE_TOKEN_EXPIRY_HOURS=72


# ── Response Caching ───────────────────────────────────────

# Redis connection URL. Leave empty to use in-memory LRU fallback.
# REDIS_URL=

# Cache TTL in seconds (default: 3600 = 1 hour)
# CACHE_TTL=3600

# Max entries for in-memory LRU cache when Redis is unavailable
# CACHE_LRU_MAX_SIZE=128
