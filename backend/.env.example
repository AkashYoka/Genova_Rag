# Copy to backend/.env (gitignored). Never commit real secrets.

ENVIRONMENT=development

# ── Localhost LLM / embeddings (default) ───────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
CHROMA_PERSIST_DIR=./data/chroma_db_ollama_nomic

# ── Production (ENVIRONMENT=production) ────────────────────
# Ollama is disabled automatically. Use Bedrock Nova + Titan:
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDING_DIMENSION=1024
# CHROMA_PERSIST_DIR=./data/chroma_db_bedrock_titan_v2

# Optional Bedrock API key. When empty, boto3 uses IAM / default AWS credentials.
AWS_BEARER_TOKEN_BEDROCK=

# US cross-region inference profile (required for Nova 2 Lite)
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-1

# POC: register without email verification link
REQUIRE_EMAIL_VERIFICATION=false

# ── Database (local | rds) ──────────────────────────────────
DB_TARGET=local
DATABASE_URL=sqlite:///./data/app.db
# LOCAL_DATABASE_URL=mysql+pymysql://pdf_rag_user:pdf_rag_pass@localhost:3306/pdf_rag?charset=utf8mb4

# AWS RDS MySQL — required when DB_TARGET=rds (never commit real passwords)
# RDS_HOST=your-instance.region.rds.amazonaws.com
# RDS_PORT=3306
# RDS_DATABASE=rag_model_notes
# RDS_USER=admin
# RDS_PASSWORD=replace-me

# ── AWS S3 (NoteBase) ───────────────────────────────────
# AWS_S3_BUCKET=gen-research
# S3_BASE_PREFIX=NoteBase
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

