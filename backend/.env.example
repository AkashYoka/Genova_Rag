# Copy to backend/.env (gitignored). Never commit real secrets.

ENVIRONMENT=development

# ── Localhost LLM / embeddings (default) ───────────────────
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
CHROMA_PERSIST_DIR=./data/chroma_db_ollama_nomic

# ── Production (ENVIRONMENT=production) ────────────────────
# Ollama is disabled automatically. Use Bedrock Nova + Titan:
# LLM_PROVIDER=bedrock
# EMBEDDING_PROVIDER=bedrock
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# EMBEDDING_DIMENSION=1024
# CHROMA_PERSIST_DIR=./data/chroma_db_bedrock_titan_v2

# Optional Bedrock API key. When empty, boto3 uses IAM / default AWS credentials.
AWS_BEARER_TOKEN_BEDROCK=

# US cross-region inference profile (required for Nova 2 Lite)
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_REGION=us-east-1

# POC: register without email verification link
REQUIRE_EMAIL_VERIFICATION=false

# ── Dropbox document source ─────────────────────────────────
# Create an app at https://www.dropbox.com/developers/apps (Scoped access,
# files.metadata.read + files.content.read + sharing.read).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REDIRECT_URI=http://127.0.0.1:7860/api/v1/auth/dropbox/callback
DROPBOX_SYNC_ENABLED=true
DROPBOX_SYNC_INTERVAL_MINUTES=60

# ── Layout-aware PDF extraction / OCR ───────────────────────
# Tesseract is the default OCR backend (install tesseract-ocr + eng data).
# Set PDF_OCR_TESSDATA_DIR or TESSDATA_PREFIX when language data is non-default.
PDF_LAYOUT_AWARE_ENABLED=true
PDF_LAYOUT_WRITE_DIAGNOSTICS=true
PDF_LAYOUT_REPORT_DIR=./data/layout_reports
PDF_OCR_ENABLED=true
PDF_OCR_BACKEND=auto
PDF_OCR_DPI=300
PDF_OCR_PSM=3
PDF_OCR_LANG=eng
PDF_OCR_TIMEOUT_SECONDS=120
PDF_OCR_TESSDATA_DIR=
PDF_TABLE_MAX_CHARS=4000
# Active: Textract DetectDocumentText (+ async multipage). Docling code kept
# but disabled in the active path. No Camelot / AnalyzeDocument TABLES.
# IAM: textract:DetectDocumentText, StartDocumentTextDetection, GetDocumentTextDetection.
PDF_DOCLING_TABLES_ENABLED=false
PDF_DOCLING_TABLEFORMER_MODE=accurate
PDF_DOCLING_DO_OCR=true
PDF_DOCLING_PAGE_BATCH_SIZE=4
PDF_TABLE_QUALITY_MIN_COLS=2
PDF_TABLE_QUALITY_MIN_ROWS=1
PDF_TABLE_QUALITY_MAX_EMPTY_CELL_RATIO=0.65
PDF_TABLE_QUALITY_MIN_STRUCTURE_CONFIDENCE=0.35
# Master switch for DetectDocumentText (name kept for env compatibility).
PDF_TEXTRACT_FALLBACK_ENABLED=true
PDF_TEXTRACT_TABLES_ENABLED=true
PDF_TEXTRACT_TABULAR_ONLY=true
PDF_TEXTRACT_ASYNC_MULTIPAGE=true
PDF_TEXTRACT_ASYNC_POLL_SECONDS=2.0
PDF_TEXTRACT_ASYNC_TIMEOUT_SECONDS=900

# Iterative evidence retrieval (table analyst can request follow-up searches)
TABLE_RAG_ITERATIVE_ENABLED=true
TABLE_RAG_MAX_ITERATIONS=2
TABLE_RAG_ITERATIVE_TOP_K=6
# RAGAS evaluation (scripts/evaluate_ragas.py)
# Uses live retrieve → interpret → generate_answer (not a demo pipeline).
# Requires ragas==0.2.15 (requirements-dev.txt) + working LLM/embeddings provider.
# Reference-based metrics need dataset "reference" fields; null scores = unavailable.
RAGAS_ENABLED=true
RAGAS_DATASET_DIR=data/evals/ragas/datasets
RAGAS_REPORT_DIR=data/evals/ragas/reports
PDF_TEXTRACT_REGION=
PDF_TEXTRACT_DPI=0
PDF_TEXTRACT_TIMEOUT_SECONDS=60
PDF_TEXTRACT_MAX_WORKERS=4
PDF_TEXTRACT_MIN_CONFIDENCE=50.0
# TableRAG production surfaces: table_card + table_row_window (interpretation folded into card).
TABLE_RAG_SEPARATE_INTERPRETATION_EMBEDDING=false
TABLE_RAG_INDEX_VERSION=v2_card_window
TABLE_RAG_ROW_WINDOW_THRESHOLD=10
TABLE_RAG_ROW_WINDOW_SIZE=8
TABLE_RAG_MAX_ROW_WINDOWS=40
# LLM query rewrite OFF by default; only used when top-1 RRF < threshold.
TABLE_RAG_QUERY_REWRITE_ENABLED=false
TABLE_RAG_REWRITE_FALLBACK_THRESHOLD=0.018
TABLE_RAG_SELECTOR_ENABLED=true
TABLE_RAG_SELECTOR_TOP_K=8
TABLE_RAG_SIBLING_EXPAND=true
TABLE_RAG_LLM_PROMPT_ROWS=5

# ── Database (local | rds) ──────────────────────────────────
DB_TARGET=local
DATABASE_URL=sqlite:///./data/app.db
# LOCAL_DATABASE_URL=mysql+pymysql://pdf_rag_user:pdf_rag_pass@localhost:3306/pdf_rag?charset=utf8mb4

# AWS RDS MySQL — required when DB_TARGET=rds (never commit real passwords)
# RDS_HOST=your-instance.region.rds.amazonaws.com
# RDS_PORT=3306
# RDS_DATABASE=rag_model_notes
# RDS_USER=admin
# RDS_PASSWORD=replace-me

# ── AWS S3 (NoteBase) ───────────────────────────────────
# AWS_S3_BUCKET=gen-research
# S3_BASE_PREFIX=NoteBase
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

